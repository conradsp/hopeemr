# Production secrets for docker-compose-emr-https.yml.
# Copy to .env on the server (never commit it) and fill in every value.
# Generate strong values with: openssl rand -base64 32

# Database and cache (required; compose refuses to start without them)
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Public URLs (defaults shown)
MEDPLUM_SERVER_URL=https://api.hopeemr.com
MEDPLUM_APP_URL=https://hopeemr.com

# Outbound email (AWS SES)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SUPPORT_EMAIL="HopeEMR" <support@hopeemr.com>

# Backups to Backblaze B2 (see scripts/backup.sh)
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
RESTIC_REPOSITORY=b2:hopeemr-backups:postgres
RESTIC_PASSWORD=
# Dead-man's-switch URL pinged after each successful backup (e.g. healthchecks.io)
BACKUP_HEALTHCHECK_URL=

# Server health check (see scripts/check-health.sh)
SERVER_HEALTHCHECK_URL=
